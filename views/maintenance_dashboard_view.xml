<odoo>
    <record id="view_gearguard_dashboard_form" model="ir.ui.view">
        <field name="name">gearguard.dashboard.form</field>
        <field name="model">gearguard.dashboard</field>
        <field name="arch" type="xml"><form string="GearGuard Maintenance Dashboard" create="0" edit="0"><sheet><div class="oe_title"><h1>GearGuard Operations Dashboard</h1></div><group><group string="Equipment"><field name="total_equipment"/><field name="active_equipment"/><field name="equipment_in_maintenance"/><field name="maintenance_due"/></group><group string="Requests"><field name="open_requests"/><field name="critical_requests"/><field name="overdue_requests"/></group></group></sheet></form></record>
    <record id="action_gearguard_dashboard" model="ir.actions.act_window"><field name="name">Operations Dashboard</field><field name="res_model">gearguard.dashboard</field><field name="view_mode">form</field><field name="target">current</field></record>
</odoo>
