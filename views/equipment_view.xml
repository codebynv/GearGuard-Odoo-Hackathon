<odoo>
    <record id="view_gearguard_equipment_tree" model="ir.ui.view">
        <field name="name">gearguard.equipment.tree</field>
        <field name="model">gearguard.equipment</field>
        <field name="arch" type="xml">
            <tree string="Equipment">
                <field name="asset_code"/>
                <field name="name"/>
                <field name="location"/>
                <field name="department"/>
                <field name="status" widget="badge"/>
                <field name="next_maintenance_date"/>
                <field name="maintenance_due" widget="boolean"/>
                <field name="open_request_count"/>
            </tree>
        </field>
    </record>

    <record id="view_gearguard_equipment_form" model="ir.ui.view">
        <field name="name">gearguard.equipment.form</field>
        <field name="model">gearguard.equipment</field>
        <field name="arch" type="xml">
            <form string="Equipment">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_requests" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="open_request_count" widget="statinfo" string="Open Requests"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. CNC Machine 01"/></h1>
                    </div>
                    <group>
                        <group string="Equipment Details">
                            <field name="asset_code"/>
                            <field name="serial_number"/>
                            <field name="department"/>
                            <field name="location"/>
                        </group>
                        <group string="Maintenance">
                            <field name="maintenance_team"/>
                            <field name="status"/>
                            <field name="maintenance_due"/>
                            <field name="last_maintenance_date"/>
                            <field name="next_maintenance_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Maintenance Requests">
                            <field name="request_ids">
                                <tree>
                                    <field name="subject"/>
                                    <field name="priority" widget="badge"/>
                                    <field name="scheduled_date"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Add equipment notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_gearguard_equipment_search" model="ir.ui.view">
        <field name="name">gearguard.equipment.search</field>
        <field name="model">gearguard.equipment</field>
        <field name="arch" type="xml">
            <search string="Search Equipment">
                <field name="name"/>
                <field name="asset_code"/>
                <field name="serial_number"/>
                <field name="location"/>
                <field name="department"/>
                <field name="status"/>
                <filter name="active" string="Active" domain="[('status','=','active')]"/>
                <filter name="maintenance" string="Under Maintenance" domain="[('status','=','maintenance')]"/>
                <filter name="due" string="Maintenance Due" domain="[('maintenance_due','=',True)]"/>
                <filter name="retired" string="Retired" domain="[('status','=','retired')]"/>
            </search>
        </field>
    </record>
</odoo>
